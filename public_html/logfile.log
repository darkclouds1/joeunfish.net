                MIN(STR_TO_DATE(ord.supply_dt, '{e84471a095f971b313c42a1a3366fe7874b2cb327ea0312f3578444667eec7d4}Y{e84471a095f971b313c42a1a3366fe7874b2cb327ea0312f3578444667eec7d4}m{e84471a095f971b313c42a1a3366fe7874b2cb327ea0312f3578444667eec7d4}d')) AS week_start,
