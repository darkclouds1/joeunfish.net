        END as serial_no,
        increate_dt,
        prod_code,
        prod_nm,
        asc_nm,
        init_stock,
        in_luxury,
        in_cheong,
        unit_cost,
        sell_price,
        out_qty,
        raw_stock,
        realuse_qty,
        remain_qty,
        raw_cost,
        total_sales,
        yield_rate
    FROM MainData
)
SELECT 
    serial_no,
    increate_dt,
    prod_code,
    prod_nm,
    asc_nm,
    init_stock,
    in_luxury,
    in_cheong,
    unit_cost,
    sell_price,
    out_qty,
    raw_stock,
    realuse_qty,
    remain_qty,
    raw_cost,
    total_sales,
    yield_rate
FROM NumberedData
ORDER BY 
    prod_code,
    CASE 
        WHEN asc_nm = '합계' THEN 2
        ELSE 1 
    END,
    asc_nm;
