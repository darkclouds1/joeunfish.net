[jofMainOrdCntChartShortCode] query= 
            SELECT 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}Y{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}m{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}d'),1) AS year_week,
                MIN(STR_TO_DATE(ord.supply_dt, '{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}Y{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}m{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}d')) AS week_start,
                MAX(STR_TO_DATE(ord.supply_dt, '{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}Y{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}m{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}d')) AS week_end,
                SUM(prd.quantity) AS total_cnt,
                MAX(prd.product_name) AS product_name,
                MAX(prd.create_dt) AS create_dt
            FROM 
                torders ord
            JOIN 
                torderproducts prd ON ord.doc_no = prd.doc_no
            WHERE 
                prd.product_code = '2000000560770'
                AND ord.supply_dt BETWEEN '20250408' AND '20250708'
            GROUP BY 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}Y{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}m{9426d639b5e456466f80b2b00b83bce02c324aaf0d4e12536146d2b14d69aafd}d'), 1)
            ORDER BY 
                year_week DESC
            LIMIT 13
