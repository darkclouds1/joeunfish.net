[ascInvt_srv.php] category: 1s[ascInvt_srv.php] user_id: proxima[ascInvt_srv.php] increate_dt: 2025-07-09[ascInvt_srv.php] SQL: 
    WITH LastKnownValues AS (
    SELECT 
        LEFT('2025-07-09', 10) as last_increate_dt, 
        t1.prod_code, 
        t1.prod_nm, 
        t1.asc_nm, 
        t1.raw_stock as last_raw_stock, 
        t1.unit_cost as last_unit_cost,
        t1.raw_cost as last_raw_cost,
        t1.sell_price as last_sell_price
    FROM tascinvt3 t1 
    WHERE t1.increate_dt = (
        SELECT MAX(increate_dt) 
        FROM tascinvt3 t2 
        WHERE t2.prod_code = t1.prod_code 
        AND t2.prod_nm = t1.prod_nm 
        AND t2.asc_nm = t1.asc_nm 
        AND DATE(increate_dt) <= '2025-07-09'
    )
),
SummaryData AS (
    SELECT 
        'SUM' as serial_no,
        LEFT('2025-07-09', 10) as increate_dt,
        t.prod_code,
        MAX(t.prod_nm) as prod_nm,
        '합계' as asc_nm,
        '' as init_stock,
        '' as in_luxury,
        '' as in_cheong,
        '' as unit_cost,
        SUM(t.out_qty) as out_qty,
        SUM(t.raw_stock) as raw_stock,
        SUM(t.realuse_qty) as realuse_qty,
        SUM(t.remain_qty) as remain_qty,
        FORMAT(SUM(t.raw_cost), 0) as raw_cost,
        FORMAT(MAX(t.sell_price), 0) as sell_price,
        FORMAT(SUM(t.out_qty) * MAX(t.sell_price), 0) as total_sales,
        CONCAT(FORMAT((SUM(t.out_qty) / NULLIF(SUM(t.realuse_qty), 0) * 100), 2), '%') as yield_rate,
        1 as is_summary
    FROM tascinvt3 t
    WHERE DATE(t.increate_dt) = '2025-07-09'
    GROUP BY t.prod_code
),
MainData AS (
    SELECT 
         '' as serial_no,
        COALESCE(LEFT(t.increate_dt, 10), last_increate_dt) as increate_dt,
        COALESCE(t.prod_code, l.prod_code) as prod_code,
        COALESCE(t.prod_nm, l.prod_nm) as prod_nm,
        COALESCE(t.asc_nm, l.asc_nm) as asc_nm,
        COALESCE(t.init_stock, l.last_raw_stock, '') as init_stock,
        COALESCE(t.in_luxury, '') as in_luxury,
        COALESCE(t.in_cheong, '') as in_cheong,
        FORMAT(COALESCE(t.unit_cost, l.last_unit_cost, ''), 0) as unit_cost,
        COALESCE(t.out_qty, '') as out_qty,
        COALESCE(t.raw_stock, l.last_raw_stock, 0) as raw_stock,
        CASE WHEN t.increate_dt IS NOT NULL THEN t.realuse_qty ELSE 0 END as realuse_qty,
        CASE WHEN t.increate_dt IS NOT NULL THEN t.remain_qty ELSE 0 END as remain_qty,
        FORMAT(COALESCE(t.raw_cost, l.last_raw_cost, 0), 0) as raw_cost,
        FORMAT(COALESCE(t.sell_price, l.last_sell_price, ''), 0) as sell_price,
        '' as total_sales,
        '' as yield_rate,
        0 as is_summary
    FROM (
        SELECT * FROM tascinvt3 WHERE DATE(increate_dt) = '2025-07-09'
    ) t 
    RIGHT JOIN LastKnownValues l 
        ON t.prod_code = l.prod_code 
        AND t.asc_nm = l.asc_nm 
        AND t.prod_nm = l.prod_nm

    UNION ALL

    SELECT *
    FROM SummaryData
),
NumberedData AS (
    SELECT 
        CASE 
            WHEN is_summary = 1 THEN 'SUM'
            WHEN DATE(increate_dt) != DATE('2025-07-09') THEN ''  -- 해당 날짜에 데이터가 없는 경우
            ELSE CAST(ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN is_summary = 0 AND DATE(increate_dt) = DATE('2025-07-09') THEN 1 ELSE 0 END 
                ORDER BY 
                    prod_code,
                    CASE 
                        WHEN asc_nm = '합계' THEN 2
                        ELSE 1 
                    END,
                    asc_nm
            ) AS CHAR)
        END as serial_no,
        increate_dt,
        prod_code,
        prod_nm,
        asc_nm,
        init_stock,
        in_luxury,
        in_cheong,
        unit_cost,
        sell_price,
        out_qty,
        raw_stock,
        realuse_qty,
        remain_qty,
        raw_cost,
        total_sales,
        yield_rate
    FROM MainData
)
SELECT 
    serial_no,
    increate_dt,
    prod_code,
    prod_nm,
    asc_nm,
    init_stock,
    in_luxury,
    in_cheong,
    unit_cost,
    sell_price,
    out_qty,
    raw_stock,
    realuse_qty,
    remain_qty,
    raw_cost,
    total_sales,
    yield_rate
FROM NumberedData
ORDER BY 
    prod_code,
    CASE 
        WHEN asc_nm = '합계' THEN 2
        ELSE 1 
    END,
    asc_nm;
        [jofMainOrdCntChartShortCode] query= 
            SELECT 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}Y{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}m{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}d'),1) AS year_week,
                MIN(STR_TO_DATE(ord.supply_dt, '{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}Y{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}m{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}d')) AS week_start,
                MAX(STR_TO_DATE(ord.supply_dt, '{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}Y{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}m{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}d')) AS week_end,
                SUM(prd.quantity) AS total_cnt,
                MAX(prd.product_name) AS product_name,
                MAX(prd.create_dt) AS create_dt
            FROM 
                torders ord
            JOIN 
                torderproducts prd ON ord.doc_no = prd.doc_no
            WHERE 
                prd.product_code = '2000000560770'
                AND ord.supply_dt BETWEEN '20250409' AND '20250709'
            GROUP BY 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}Y{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}m{6825047e41e728ba5d31a7397e6f731cdd85c0b13505e697e869b16514651a73}d'), 1)
            ORDER BY 
                year_week DESC
            LIMIT 13
