        [jofMainOrdCntChartShortCode] query= 
            SELECT 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}Y{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}m{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}d'),1) AS year_week,
                MIN(STR_TO_DATE(ord.supply_dt, '{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}Y{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}m{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}d')) AS week_start,
                MAX(STR_TO_DATE(ord.supply_dt, '{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}Y{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}m{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}d')) AS week_end,
                SUM(prd.quantity) AS total_cnt,
                MAX(prd.product_name) AS product_name,
                MAX(prd.create_dt) AS create_dt
            FROM 
                torders ord
            JOIN 
                torderproducts prd ON ord.doc_no = prd.doc_no
            WHERE 
                prd.product_code = '2000000560770'
                AND ord.supply_dt BETWEEN '20250409' AND '20250709'
            GROUP BY 
                YEARWEEK(STR_TO_DATE(ord.supply_dt, '{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}Y{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}m{04be9add6dc498764b378a1d2033d96436a72396aa58995a1be10935d4ceef6f}d'), 1)
            ORDER BY 
                year_week DESC
            LIMIT 13
