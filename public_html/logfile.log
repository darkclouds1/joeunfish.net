                        COUNT(*) OVER () AS TotalCount,
                        increate_dt, 
                        wpu.display_name as display_name,
                        lc_no, 
                        barcode_one, 
                        barcode_two, 
                        weight, 
                        prod_date, 
                        create_dt
                   FROM tbarcodein AS tbar, wp_users AS wpu 
                  WHERE 1 
                    AND tbar.create_id = wpu.user_login    AND lc_no = '8775'   AND LEFT(increate_dt, 10) = '2025-07-09' )
