    SELECT *
    FROM SummaryData
),
NumberedData AS (
    SELECT 
        CASE 
            WHEN is_summary = 1 THEN 'SUM'
            WHEN DATE(increate_dt) != DATE('2025-07-08') THEN ''  -- 해당 날짜에 데이터가 없는 경우
            ELSE CAST(ROW_NUMBER() OVER (
                PARTITION BY CASE WHEN is_summary = 0 AND DATE(increate_dt) = DATE('2025-07-08') THEN 1 ELSE 0 END 
