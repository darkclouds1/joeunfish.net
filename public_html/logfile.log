                MIN(STR_TO_DATE(ord.supply_dt, '{a55579edfb6dbc45936a60f8613d8e2a1941e354042369ef6db2b7b1376df529}Y{a55579edfb6dbc45936a60f8613d8e2a1941e354042369ef6db2b7b1376df529}m{a55579edfb6dbc45936a60f8613d8e2a1941e354042369ef6db2b7b1376df529}d')) AS week_start,
