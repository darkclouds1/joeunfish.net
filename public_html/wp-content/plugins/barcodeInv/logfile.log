ln250::serDoc_no::sql=SELECT ORD.doc_no 
                  FROM `torders` AS ORD 
                  JOIN torderproducts AS PRD ON ORD.doc_no = PRD.doc_no AND PRD.product_code IN ('2000000560770','0200000651343','2000000668592', '2000000614117')
                 WHERE ORD.dest_code = '064'
                   AND ORD.supply_dt = '20250710'
                 GROUP BY ORD.doc_no
                 ORDER BY ORD.doc_no;
